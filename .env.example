APP_NAME="LIV corp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:8000
APP_LOCALE=fr

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=daily
LOG_LEVEL=debug

# --- Base de données ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=livcorp
DB_USERNAME=livcorp_user
DB_PASSWORD=

# --- Session / Sanctum ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SANCTUM_TOKEN_EXPIRATION=1440

# --- File d'attente ---
QUEUE_CONNECTION=database

# --- Cache ---
CACHE_STORE=database

# --- Broadcast temps réel (suivi GPS) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- E-mail transactionnel (Brevo) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@livcorp.bj"
MAIL_FROM_NAME="LIV corp"
BREVO_API_KEY=

# --- FedaPay ---
FEDAPAY_ENV=sandbox
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# --- Cartographie / Géolocalisation ---
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# --- Commissions ---
COMMISSION_RATE_DEFAULT=15
COMMISSION_PAYOUT_FREQUENCY=weekly

# --- Stockage des pièces justificatives (privé) ---
FILESYSTEM_DISK=local
DOCUMENTS_DISK=documents_private
