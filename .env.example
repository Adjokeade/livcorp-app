APP_NAME="LIV corp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:8000
APP_LOCALE=fr

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=daily
LOG_LEVEL=debug

# --- Base de données ---
DB_CONNECTION=mysql
# Erreur « La clé est trop longue » (1071) ? Le moteur InnoDB est déjà utilisé par défaut ; avec un très vieux MySQL (< 5.7), ajouter DB_LEGACY_MYSQL=true.
# DB_LEGACY_MYSQL=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=livcorp
DB_USERNAME=livcorp_user
DB_PASSWORD=

# --- Session / Sanctum ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Auth du front = token Bearer (Sanctum personal access tokens), pas de cookie SPA.
# Ne PAS déclarer le domaine du front comme "stateful" : cela activerait la
# validation CSRF de Sanctum et ferait échouer /auth/login & /auth/register en 419.
# SANCTUM_STATEFUL_DOMAINS=localhost:5173
SANCTUM_TOKEN_EXPIRATION=1440

# --- File d'attente ---
QUEUE_CONNECTION=database

# --- Cache ---
CACHE_STORE=database

# --- Broadcast temps réel (suivi GPS) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- E-mail transactionnel (Brevo) ---
# Envoi d'e-mails : SILENCIEUX par défaut (rien ne part, les messages sont seulement écrits dans storage/logs).
# Pour l'activer : MAIL_ENABLED=true, puis renseigner les identifiants SMTP Brevo ci-dessous.
# Vérifier ensuite avec : php artisan mail:status  puis  php artisan mail:test vous@exemple.com
MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@livcorp.bj"
MAIL_FROM_NAME="LIV corp"
BREVO_API_KEY=

# --- KKiaPay (paiement en ligne : Mobile Money MTN / Moov, carte) ---
# Clés : tableau de bord KKiaPay > Développeurs > Clés API. KKIAPAY_SANDBOX=true tant que le compte est en test.
# Les clés privée et secrète restent sur le serveur ; seule la clé publique est transmise au navigateur.
# Webhook : à créer dans le tableau de bord, URL https://VOTRE-DOMAINE/api/v1/webhooks/kkiapay,
# avec un « secret hash » à recopier dans KKIAPAY_WEBHOOK_SECRET.
KKIAPAY_SANDBOX=true
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_WEBHOOK_SECRET=

# --- Cartographie / Géolocalisation ---
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# --- Commissions ---
COMMISSION_RATE_DEFAULT=15
COMMISSION_PAYOUT_FREQUENCY=weekly

# --- Stockage des pièces justificatives (privé) ---
FILESYSTEM_DISK=local
DOCUMENTS_DISK=documents_private

# --- Frontend (Vite) ---
# Exposées au navigateur : le préfixe VITE_ est obligatoire. Les valeurs
# ${...} sont résolues par dotenv-expand (laravel-vite-plugin) à partir des
# variables backend ci-dessus, il n'y a donc rien à ressaisir.
VITE_API_URL="${APP_URL}/api/v1"
VITE_BACKEND_URL="${APP_URL}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Vérification e-mail avant de commander/livrer : DÉSACTIVÉE pour le moment (comptes validés d'office).
# À passer à true quand l'envoi d'e-mails sera activé (MAIL_ENABLED=true).
EMAIL_VERIFICATION_ENABLED=false

# --- Notifications push (Web Push / VAPID) ---
# Générer les clés avec : php artisan push:vapid --write  (à conserver : les changer désabonne tous les appareils)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@livcorp.bj
# Ce PHP autonome ne trouve pas openssl.cnf : exporter OPENSSL_CONF=/etc/ssl/openssl.cnf avant artisan serve / queue:work

# Durée de la session administrateur, en minutes (8 h par défaut)
ADMIN_TOKEN_MINUTES=480
